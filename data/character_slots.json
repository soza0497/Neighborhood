{
	"_ayuda": "Personaje modular (Fase 7). Un solo ESQUELETO para todos y piezas intercambiables por 'slot' (hueco). Cada pieza es un .glb en assets/models/character/. Si una pieza no existe, está rota o 'Usar modelos' está apagado, se queda la figura simple de siempre (nunca se rompe). skeleton = nombres de huesos que debe tener el esqueleto del cuerpo (en Blender, en inglés y minúsculas). Cada slot: id, name (para el editor), appearance_key (con qué clave se guarda la elección en el personaje), options_key (lista de data/character_options.json) u options (lista propia), attach (hueso donde se pega la pieza; si el cuerpo no trae esqueleto se pega en 'fallback_pos' en metros, con los pies en y=0 y la cara hacia +z), hides (nombres de las figuras simples que se esconden cuando la pieza carga; * vale por cualquier cosa), colors (qué materiales de la pieza se pintan con el color elegido: {nombre_material: clave_de_apariencia}). Cada opción puede traer 'model': ruta al .glb. animations = ganchos de animación: nombre que pide el juego → nombres aceptados en el AnimationPlayer del .glb (idle, walk, sleep, cook... el resto de ganchos está en character_animator.gd).",
	"format_version": 1,
	"model_dir": "res://assets/models/character/",
	"skeleton": ["root", "hips", "spine", "chest", "neck", "head", "arm_l", "hand_l", "arm_r", "hand_r", "leg_l", "foot_l", "leg_r", "foot_r", "tail"],
	"slots": [
		{ "id": "body", "name": "Cuerpo base", "appearance_key": "body", "options": [{ "id": "base", "name": "Base" }],
		  "attach": "root", "fallback_pos": [0, 0, 0], "hides": ["Legs", "Body", "ArmLeft", "ArmRight"],
		  "colors": { "skin": "skin", "shirt": "shirt", "pants": "pants" } },
		{ "id": "head", "name": "Cabeza", "appearance_key": "head", "options": [{ "id": "round", "name": "Redonda" }],
		  "attach": "head", "fallback_pos": [0, 1.0, 0], "hides": ["Head"],
		  "colors": { "skin": "skin" } },
		{ "id": "hair", "name": "Pelo", "appearance_key": "hairstyle", "options_key": "hairstyles",
		  "attach": "head", "fallback_pos": [0, 1.0, 0], "hides": ["Hair", "Hair?*"],
		  "colors": { "hair": "hair" } },
		{ "id": "eyes", "name": "Ojos", "appearance_key": "eyes", "options_key": "eyes",
		  "attach": "head", "fallback_pos": [0, 1.0, 0], "hides": ["EyeLeft", "EyeRight", "Eye?*"],
		  "colors": { "skin": "skin" } },
		{ "id": "mouth", "name": "Boca", "appearance_key": "mouth", "options_key": "mouths",
		  "attach": "head", "fallback_pos": [0, 1.0, 0], "hides": ["Mouth", "Mouth?*"],
		  "colors": { "skin": "skin" } },
		{ "id": "ears", "name": "Orejas", "appearance_key": "ears", "options": [{ "id": "none", "name": "Sin orejas" }],
		  "attach": "head", "fallback_pos": [0, 1.0, 0], "hides": [], "colors": { "skin": "skin", "hair": "hair" } },
		{ "id": "tail", "name": "Cola", "appearance_key": "tail", "options": [{ "id": "none", "name": "Sin cola" }],
		  "attach": "hips", "fallback_pos": [0, 0.45, -0.2], "hides": [], "colors": { "skin": "skin", "hair": "hair" } },
		{ "id": "clothes", "name": "Ropa", "appearance_key": "outfit", "options": [{ "id": "none", "name": "Camiseta y pantalón" }],
		  "attach": "spine", "fallback_pos": [0, 0, 0], "hides": [], "colors": { "shirt": "shirt", "pants": "pants" } },
		{ "id": "accessory", "name": "Accesorio", "appearance_key": "accessory", "options": [{ "id": "none", "name": "Ninguno" }],
		  "attach": "head", "fallback_pos": [0, 1.0, 0], "hides": [], "colors": { "hair": "hair" } }
	],
	"animations": {
		"idle": ["idle", "idle_loop", "reposo"],
		"walk": ["walk", "walking", "walk_loop", "caminar"],
		"sleep": ["sleep", "sleeping", "dormir"],
		"cook": ["cook", "cooking", "cocinar"],
		"sit": ["sit", "sitting", "sentar"],
		"eat": ["eat", "eating", "comer"],
		"shower": ["shower", "ducha"],
		"use": ["use", "interact"],
		"arrive": ["arrive", "happy_jump"],
		"wave": ["wave", "saludar"],
		"cough": ["cough", "toser"],
		"hurt": ["hurt", "lying_down"],
		"fall": ["fall", "falling", "caer"],
		"slip": ["slip", "slipping", "resbalar"],
