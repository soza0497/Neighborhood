[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Root" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 16

[node name="TopLeft" type="VBoxContainer" parent="Root"]
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 0
mouse_filter = 2

[node name="FpsLabel" type="Label" parent="Root/TopLeft"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0.15, 0.2, 0.3, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 26
text = "0 FPS"

[node name="InfoLabel" type="Label" parent="Root/TopLeft"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0.15, 0.2, 0.3, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 18
text = "Neighborhood"

[node name="CenterButton" type="Button" parent="Root"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 64)
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 8
theme_override_font_sizes/font_size = 22
text = "Centrar"
