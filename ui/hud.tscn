[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud.gd" id="1_hud"]

[sub_resource type="StyleBoxFlat" id="Style_bar"]
bg_color = Color(0.13, 0.17, 0.25, 0.85)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0

[sub_resource type="StyleBoxFlat" id="Style_hint"]
bg_color = Color(0.13, 0.17, 0.25, 0.7)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 14.0
content_margin_top = 6.0
content_margin_right = 14.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="Style_confirm"]
bg_color = Color(0.2, 0.62, 0.32, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Root" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Layout" type="VBoxContainer" parent="Root"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="TopRow" type="HBoxContainer" parent="Root/Layout"]
layout_mode = 2
mouse_filter = 2

[node name="TopLeft" type="VBoxContainer" parent="Root/Layout/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="FpsLabel" type="Label" parent="Root/Layout/TopRow/TopLeft"]
