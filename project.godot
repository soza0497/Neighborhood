; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Neighborhood"
config/version="0.9.0"
run/main_scene="res://ui/login_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
Catalog="*res://scripts/autoload/catalog.gd"
Style="*res://scripts/autoload/style.gd"
Sound="*res://scripts/autoload/sound.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
Economy="*res://scripts/autoload/economy.gd"
GameServer="*res://scripts/autoload/game_server.gd"
Couple="*res://scripts/autoload/couple.gd"
Restaurant="*res://scripts/autoload/restaurant.gd"
Parcel="*res://scripts/autoload/parcel.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
